# Usuário e senha de quem pode atualizar o dash (obrigatórios)
ADMIN_USER=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Segredo para assinar a sessão (obrigatório). Gere com: openssl rand -base64 32
AUTH_SECRET=

# Se "true", até para VER o dash é preciso login (padrão: leitura aberta, só upload protegido)
VIEW_REQUIRES_LOGIN=false

# Banco para guardar os dados enviados (Upstash Redis via Vercel Marketplace).
# A integração do Vercel já cria KV_REST_API_URL e KV_REST_API_TOKEN sozinha.
KV_REST_API_URL=
KV_REST_API_TOKEN=
